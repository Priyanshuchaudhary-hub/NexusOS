# ==============================================================================
# NexusOS — Version Control Exclusion Rules (.gitignore)
# Standard: Zero-Secret Leakage & High-Performance Repository Hygiene
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
jspm_packages/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.pnp
.pnp.js

# ------------------------------------------------------------------------------
# 2. Production Build Artifacts & Distribution
# ------------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 3. Environment Variables & Secret Credentials
# CRITICAL: Never commit real API keys, OAuth secrets, or Firebase tokens
# ------------------------------------------------------------------------------
.env
.env.development.local
.env.test.local
.env.production.local
.env.local
*.env.local

# Allow committing template environment configuration
!.env.example

# ------------------------------------------------------------------------------
# 4. Runtime Logs & Diagnostics
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 5. Testing, Code Coverage & E2E Reports
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
playwright/.cache/
lighthouse-report/

# ------------------------------------------------------------------------------
# 6. Local Development & Bundler Caches
# ------------------------------------------------------------------------------
.vite/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tmp
*.temp

# ------------------------------------------------------------------------------
# 7. IDE & Editor Specific Configurations
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------------------------------------------
# 8. Operating System Debris
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 9. AI Agent Sessions & Temporary Scratchpads
# ------------------------------------------------------------------------------
.tempmediaStorage/
.system_generated/
scratch/
*.session.json
