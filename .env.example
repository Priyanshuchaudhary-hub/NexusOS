# Nexus OS — Firebase Authentication Environment Variables
# Replace the placeholder values below with your credentials from the Firebase Console:
# https://console.firebase.google.com/ -> Project Settings -> General -> Your apps -> Web app

VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=nexus-os-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nexus-os-app
VITE_FIREBASE_STORAGE_BUCKET=nexus-os-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
